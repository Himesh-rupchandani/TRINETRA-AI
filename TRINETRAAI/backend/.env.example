# ==========================================
# TRINETRA AI - Environment Configuration
# ==========================================
# QUICK START — BACKEND + FRONTEND ONLY (no cv-engine needed):
#   1. cp .env.example .env
#   2. python -m scripts.seed_demo
#   3. uvicorn app.main:app --host 0.0.0.0 --port 8000
# Frontend will proxy /api to http://localhost:8000 automatically.
# Keep DEMO_MODE=true and AUTO_START_CAMERAS=false for simple run.

# Application Settings
PROJECT_NAME="TRINETRA AI - Intelligent CCTV Surveillance"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ---- REAL live camera source (the authorized Ahmedabad CCTV slot) --------
# Leave LIVE_CAMERA_STREAM_URL empty until you have an AUTHORIZED stream URL.
# Empty  -> the camera shows "NOT_CONFIGURED" ("Camera source not configured").
# Set it -> the backend connects like any real camera (also set AUTO_START_CAMERAS=true).
# Supported: rtsp | hls | webrtc | file. Restart the backend after changes.
LIVE_CAMERA_ID=CAMLIVE
LIVE_CAMERA_NAME=SG Highway Junction, Ahmedabad
LIVE_CAMERA_LOCATION=Ahmedabad, Gujarat
LIVE_CAMERA_STREAM_TYPE=rtsp
LIVE_CAMERA_STREAM_URL=
LIVE_CAMERA_STATUS=

# Start resident stream workers for REAL network cameras (rtsp/hls) at boot.
# File-backed demo cameras are unaffected — they play on demand.
AUTO_START_CAMERAS=false

# Root of the CV engine's evidence crops (served at /api/evidence/...).
EVIDENCE_ROOT=../../cv-engine/evidence

# ---- Sentinel Camera Grid credentials (KEEP SECRET — never commit) -------
# Real values live ONLY in your local .env (gitignored). The '@' in the email
# is percent-encoded (%40) automatically when connection URLs are built.
SENTINEL_EMAIL=
SENTINEL_PASSWORD=
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_HLS_BASE_URL=https://cctv.corp8.cloud
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554

# Database Configuration (Defaults to SQLite if PostgreSQL is not specified)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/trinetra_db
# For SQLite: sqlite:///./trinetra.db
DATABASE_URL=sqlite:///./trinetra.db

# Redis Cache & Message Queue (Optional)
REDIS_URL=redis://localhost:6379/0

# CCTV Camera Default Streams (For quick start / testing)
DEFAULT_CAMERA_STREAM_URL=https://cctv.corp8.cloud/cam04/index.m3u8
DEFAULT_CAMERA_STREAM_TYPE=hls
RTSP_TRANSPORT=tcp

# AI & Computer Vision Settings
# Vehicle weights for the green boxes. The name is tried as given, then under
# the backend root, then as this repo's bundled offline weight (yolo11n).
YOLO_MODEL_PATH=models/yolo11s.pt
# ---- LIVE view (the green boxes in the browser) --------------------------
# These two are the LIVE knobs; the offline video pass has its own ANALYSIS_*
# pair below. They used to be 0.45 / 640 while analysis ran 0.35 / 960, so the
# same vehicle was boxed in the recording but missing or coarse in the live
# view. Live now runs the same quality, and protects its frame rate with the
# auto-pacing settings instead of a lower resolution.
# Detections under this score are dropped. 0.45+ removes borderline false
# positives (a pedestrian beside parked bikes) at ~25% cost of distant boxes.
CONFIDENCE_THRESHOLD=0.35
# NMS IoU for the vehicle detector. 0.45 (not Ultralytics' 0.7) is what removes
# the second and third box around the SAME vehicle; separate vehicles stay
# separate because their mutual IoU is far below this.
DETECTION_IOU=0.45
# One box per vehicle even when the model hedges car vs bus vs truck.
DETECTION_AGNOSTIC_NMS=true
# Inference resolution the LIVE view aims for. Measured on this repo's own
# 1280x720 footage with the shipped weight (yolo11s, iou 0.45, agnostic NMS):
#   640 -> 6.8 vehicles/frame at 5.5 fps   768 -> 14.8 at 4.7 fps
#   960 -> 18.0 at 3.8 fps                1280 -> 25.1 at 3.4 fps
# Higher finds more distant vehicles; it never makes a box bigger.
DETECTION_IMGSZ=960
# ---- how hard the live detector looks -----------------------------------
# Auto-pacing: the detector times its own passes and walks down a quality ladder
# (512 single -> 640 -> 768 -> 960 -> 1280 -> native-resolution strips) when the
# median run exceeds the budget, then back up when the CPU frees again. Because
# inference runs on a worker thread (LIVE_ASYNC_DETECT), a slow pass costs box
# LATENCY, never a dropped frame: measured on a 2-CPU box, the stream held ~19
# fps whether the detector was at 209 ms or 866 ms per pass.
LIVE_ADAPTIVE_IMGSZ=true
# A pass should stay under this. Raise it to trade staleness for depth: 450 ->
# 960 single pass (measured 18.0 vehicles/frame on this repo's footage), 1200 ->
# the strips pass (~21.8, boxes up to ~0.9 s old). Set 0 to always look as deep
# as the machine can.
LIVE_INFER_BUDGET_MS=450
LIVE_IMGSZ_FLOOR=640
# Quality ladder override, exactly three values:
#   auto - the governor chooses (default);
#   eco  - never spend a second pass, cheapest single look;
#   max  - always the deepest look (native-resolution strips), whatever the CPU
#          cost. Because detection runs off the render path this costs staleness
#          only: measured 11.2 fps with ~21% more vehicles boxed vs 11.1 fps for
#          the auto level on this 2-CPU box.
LIVE_QUALITY=auto
# Detect on a worker per camera instead of inside the MJPEG loop, so the stream
# renders at its own rate with the freshest REAL boxes and never queues frames.
# false restores the old inline path (detect every DETECTION_EVERY_N_FRAMES and
# replay in between), which is what a single-CPU box may prefer.
LIVE_ASYNC_DETECT=true
# Boxes older than this are dropped rather than drawn - a stalled detector must
# never leave a vehicle boxed in front of an empty road. Nothing is extrapolated
# or carried: a box is only ever shown where the model actually saw it.
LIVE_BOX_MAX_AGE_MS=900
# Ceiling for the widening above: the window may grow to two passes of measured
# cadence, never beyond this. A detector slower than this loses its overlay
# rather than drawing boxes where nothing is.
LIVE_STALENESS_CEILING_MS=2500
# Only used by the inline path above: how often the model really runs, with the
# last real detections replayed in between.
DETECTION_EVERY_N_FRAMES=2
# ---- offline video analysis ------------------------------------------------
# Quality bound instead of rate bound: it looks at the frame whole AND at
# native-resolution vertical strips, then merges to one box per vehicle. Measured
# on 33 hand-checked frames of this repo's own footage: 11.8 -> 21.8 vehicles per
# frame and mean box area 2.51% -> 1.40% of the frame, i.e. it finds nearly twice
# as many vehicles and each box is tighter. ~830 ms/frame on CPU.
ANALYSIS_MULTISCALE=true
DETECTION_STRIPS=2
# Tile fallback for frames far wider than the pixel budget (1920x1080 and up).
DETECTION_TILE=640
DETECTION_MAX_TILES=6
# Duplicate reduction between passes: a box that is mostly inside a comparable
# one is the same vehicle seen twice. The area guard is what stops a motorcycle
# genuinely in front of a bus being deleted. Set the threshold to 0 to disable.
DETECTION_CONTAINMENT_THR=0.60
DETECTION_CONTAINMENT_AREA_GUARD=3.0
ANALYSIS_DETECTION_IMGSZ=960
ANALYSIS_CONFIDENCE_THRESHOLD=0.35
# Seconds allowed to re-encode an uploaded clip OpenCV cannot decode (DVR
# .dav/.wmv/odd profiles) into H.264 MP4 before it is rejected with the reason.
# Needs imageio-ffmpeg (already in requirements.txt).
ANALYSIS_CONVERT_TIMEOUT_SEC=1800
# 0.0 = outline only, which is the reference look: the border marks the vehicle,
# and nothing is painted over the road. Raise it for a light interior tint.
DETECTION_BOX_FILL_ALPHA=0.0
PROCESS_EVERY_N_FRAMES=3
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.60
TRACK_BUFFER=30

# Mock / Demo Mode (Set to true to generate realistic simulated detections when hardware/models are offline)
DEMO_MODE=true

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Upload Settings (per file; CCTV/DVR exports are often >250 MB)
MAX_UPLOAD_SIZE_MB=1024
UPLOAD_DIR=uploads
