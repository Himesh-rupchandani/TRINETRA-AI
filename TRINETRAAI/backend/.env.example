# ==========================================
# TRINETRA AI - Environment Configuration
# ==========================================

# Application Settings
PROJECT_NAME="TRINETRA AI - Intelligent CCTV Surveillance"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ---- REAL live camera source (the authorized Ahmedabad CCTV slot) --------
# Leave LIVE_CAMERA_STREAM_URL empty until you have an AUTHORIZED stream URL.
# Empty  -> the camera shows "NOT_CONFIGURED" ("Camera source not configured").
# Set it -> the backend can connect like any real camera. On-demand detection
# works without AUTO_START_CAMERAS; enable auto-start only for workers you
# deliberately want running in the background. Restart after changes.
# Supported viewer types: rtsp | hls | webrtc | whep | file.
# This value stays only in this gitignored local .env. The database/API retain
# a credential-free source reference, and logs redact userinfo/query tokens.
LIVE_CAMERA_ID=CAMLIVE
LIVE_CAMERA_NAME=SG Highway Junction, Ahmedabad
LIVE_CAMERA_LOCATION=Ahmedabad, Gujarat
LIVE_CAMERA_STREAM_TYPE=rtsp
LIVE_CAMERA_STREAM_URL=
# If the operator's viewing feed is WHEP/WebRTC, give OpenCV its separately
# authorized RTSP/HLS source here. OpenCV cannot negotiate WHEP directly.
LIVE_CAMERA_INGEST_URL=
LIVE_CAMERA_INGEST_TYPE=
LIVE_CAMERA_STATUS=

# Start resident stream workers for REAL network cameras (rtsp/hls) at boot.
# File-backed demo cameras are unaffected — they play on demand.
AUTO_START_CAMERAS=false

# Root of the CV engine's evidence crops (served at /api/evidence/...).
EVIDENCE_ROOT=../../cv-engine/evidence

# ---- Sentinel Camera Grid credentials (KEEP SECRET — never commit) -------
# Real values live ONLY in your local backend/.env (gitignored). On Windows,
# scripts/configure-official-camera.ps1 creates this local file and opens it in
# Notepad. Enter the approved account only after the equals signs below.
# The '@' in the email is percent-encoded (%40) automatically when RTSP/HLS
# connection URLs are built. If a value contains spaces or #, wrap it in quotes.
SENTINEL_EMAIL=
SENTINEL_PASSWORD=
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# In real mode, load the authorized catalogue at backend startup when the
# server-side email/password above are configured. It creates no demo rows.
SENTINEL_AUTO_SYNC=true
SENTINEL_HLS_BASE_URL=https://cctv.corp8.cloud
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554

# Database Configuration (Defaults to SQLite if PostgreSQL is not specified)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/trinetra_db
# For SQLite: sqlite:///./trinetra.db
DATABASE_URL=sqlite:///./trinetra.db

# Redis Cache & Message Queue (Optional)
REDIS_URL=redis://localhost:6379/0

# CCTV Camera Default Streams (For quick start / testing)
DEFAULT_CAMERA_STREAM_URL=https://cctv.corp8.cloud/cam04/index.m3u8
DEFAULT_CAMERA_STREAM_TYPE=hls
RTSP_TRANSPORT=tcp

# AI & Computer Vision Settings
# YOLO11 is the trained detector; all values are backend-only. The default
# 960 image size improves small/distant vehicle recall. For a slower CPU set
# it to 640; for accuracy-first dense traffic on a GPU use yolo11s.pt and
# optionally DETECTION_TILE_GRID=2.
YOLO_MODEL_PATH=models/yolo11n.pt
CONFIDENCE_THRESHOLD=0.35
DETECTION_LOW_CONFIDENCE=0.20
DETECTION_IMGSZ=960
DETECTION_DEVICE=cpu
DETECTION_EVERY_N_FRAMES=2
DETECTION_NMS_IOU_THRESHOLD=0.70
DETECTION_DUPLICATE_IOU_THRESHOLD=0.82
DETECTION_MAX_DETECTIONS=300
DETECTION_MIN_BOX_AREA=9
DETECTION_INCLUDE_BICYCLES=true
DETECTION_TRACK_MAX_AGE_SEC=1.25
DETECTION_TRACK_MIN_HITS=1
DETECTION_LOW_CONFIDENCE_CONFIRM_HITS=2
DETECTION_TRACK_IOU_THRESHOLD=0.18
DETECTION_TRACK_CENTER_DISTANCE=1.35
DETECTION_TILE_GRID=1
DETECTION_TILE_OVERLAP=0.20
DETECTION_TILE_MIN_FRAME_EDGE=1400
DETECTION_TILE_EVERY_N_INFERENCES=4
DETECTION_SHOW_TRACK_IDS=false
PROCESS_EVERY_N_FRAMES=3
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.60
TRACK_BUFFER=30
VEHICLE_DETECTION_ENABLED=true

# Mock / Demo Mode (Set to true to generate realistic simulated detections when hardware/models are offline)
DEMO_MODE=true

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE_MB=250
UPLOAD_DIR=uploads
