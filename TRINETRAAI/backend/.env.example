# ==========================================
# TRINETRA AI - Environment Configuration
# ==========================================
# QUICK START — BACKEND + FRONTEND ONLY (no cv-engine needed):
#   1. cp .env.example .env
#   2. python -m scripts.seed_demo
#   3. uvicorn app.main:app --host 0.0.0.0 --port 8000
# Frontend will proxy /api to http://localhost:8000 automatically.
# Keep DEMO_MODE=true and AUTO_START_CAMERAS=false for simple run.

# Application Settings
PROJECT_NAME="TRINETRA AI - Intelligent CCTV Surveillance"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# ---- REAL live camera source (the authorized Ahmedabad CCTV slot) --------
# Leave LIVE_CAMERA_STREAM_URL empty until you have an AUTHORIZED stream URL.
# Empty  -> the camera shows "NOT_CONFIGURED" ("Camera source not configured").
# Set it -> the backend connects like any real camera (also set AUTO_START_CAMERAS=true).
# Supported: rtsp | hls | webrtc | file. Restart the backend after changes.
LIVE_CAMERA_ID=CAMLIVE
LIVE_CAMERA_NAME=SG Highway Junction, Ahmedabad
LIVE_CAMERA_LOCATION=Ahmedabad, Gujarat
LIVE_CAMERA_STREAM_TYPE=rtsp
LIVE_CAMERA_STREAM_URL=
LIVE_CAMERA_STATUS=

# Start resident stream workers for REAL network cameras (rtsp/hls) at boot.
# File-backed demo cameras are unaffected — they play on demand.
AUTO_START_CAMERAS=false

# Root of the CV engine's evidence crops (served at /api/evidence/...).
EVIDENCE_ROOT=../../cv-engine/evidence

# ---- Sentinel Camera Grid credentials (KEEP SECRET — never commit) -------
# Real values live ONLY in your local .env (gitignored). The '@' in the email
# is percent-encoded (%40) automatically when connection URLs are built.
SENTINEL_EMAIL=
SENTINEL_PASSWORD=
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_HLS_BASE_URL=https://cctv.corp8.cloud
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554

# Database Configuration (Defaults to SQLite if PostgreSQL is not specified)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/trinetra_db
# For SQLite: sqlite:///./trinetra.db
DATABASE_URL=sqlite:///./trinetra.db

# Redis Cache & Message Queue (Optional)
REDIS_URL=redis://localhost:6379/0

# CCTV Camera Default Streams (For quick start / testing)
DEFAULT_CAMERA_STREAM_URL=https://cctv.corp8.cloud/cam04/index.m3u8
DEFAULT_CAMERA_STREAM_TYPE=hls
RTSP_TRANSPORT=tcp

# AI & Computer Vision Settings
# Vehicle weights for the green boxes. The name is tried as given, then under
# the backend root, then as this repo's bundled offline weight (yolo11n).
YOLO_MODEL_PATH=models/yolo11s.pt
# ---- LIVE view (the green boxes in the browser) --------------------------
# These two are the LIVE knobs; the offline video pass has its own ANALYSIS_*
# pair below. They used to be 0.45 / 640 while analysis ran 0.35 / 960, so the
# same vehicle was boxed in the recording but missing or coarse in the live
# view. Live now runs the same quality, and protects its frame rate with the
# auto-pacing settings instead of a lower resolution.
# Detections under this score are dropped. 0.45+ removes borderline false
# positives (a pedestrian beside parked bikes) at ~25% cost of distant boxes.
CONFIDENCE_THRESHOLD=0.35
# NMS IoU for the vehicle detector. 0.45 (not Ultralytics' 0.7) is what removes
# the second and third box around the SAME vehicle; separate vehicles stay
# separate because their mutual IoU is far below this.
DETECTION_IOU=0.45
# One box per vehicle even when the model hedges car vs bus vs truck.
DETECTION_AGNOSTIC_NMS=true
# Inference resolution the LIVE view aims for. Measured on this repo's own
# 1280x720 footage with the shipped weight (yolo11s, iou 0.45, agnostic NMS):
#   640 -> 6.8 vehicles/frame at 5.5 fps   768 -> 14.8 at 4.7 fps
#   960 -> 18.0 at 3.8 fps                1280 -> 25.1 at 3.4 fps
# Higher finds more distant vehicles; it never makes a box bigger.
DETECTION_IMGSZ=960
# Auto-pacing: the detector times its own inferences and walks imgsz down the
# 1280/960/768/640/512 ladder when the median run is slower than the budget,
# then back up when the CPU frees again. A weak server therefore loses a little
# resolution instead of dropping live frames. Set false to pin DETECTION_IMGSZ.
LIVE_ADAPTIVE_IMGSZ=true
LIVE_INFER_BUDGET_MS=260
LIVE_IMGSZ_FLOOR=640
# How often the live loop really runs the model. The frames in between are drawn
# with the last REAL detections, so the overlay stays stable at full stream rate
# instead of flickering. 1 = annotate every displayed frame (no box lag on fast
# vehicles, fewer frames per second); 3+ = share the CPU with the ingest workers.
DETECTION_EVERY_N_FRAMES=2
# Offline video analysis is quality bound instead: a larger frame passes fewer
# pixels per vehicle, which is what separates parked/overlapping vehicles and
# still finds the distant ones.
ANALYSIS_DETECTION_IMGSZ=960
ANALYSIS_CONFIDENCE_THRESHOLD=0.35
# 0.0 = outline only. Kept small on purpose: a heavy fill makes any padding
# look like a green slab over the road.
DETECTION_BOX_FILL_ALPHA=0.18
PROCESS_EVERY_N_FRAMES=3
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.60
TRACK_BUFFER=30

# Mock / Demo Mode (Set to true to generate realistic simulated detections when hardware/models are offline)
DEMO_MODE=true

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Upload Settings
MAX_UPLOAD_SIZE_MB=250
UPLOAD_DIR=uploads
