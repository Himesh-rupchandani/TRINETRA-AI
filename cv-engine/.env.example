# ---------------------------------------------------------------
# TRINETRA AI — CV engine configuration.
# Copy to `.env` (gitignored) or export in the environment.
# Only non-secret values belong here. Never add Sentinel passwords,
# API keys or tokens: they would be logged or leaked.
# ---------------------------------------------------------------

# Sentinel catalogue (single source of truth for cameras).
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
CATALOGUE_TIMEOUT_S=8

# Backend that receives POST /api/events.
BACKEND_BASE_URL=http://127.0.0.1:8000
EVENTS_PATH=/api/events

# Detection model (resolved against ./models first, so offline works).
MODEL_PATH=yolo11n.pt
DEVICE=auto            # auto | cpu | cuda
CONF_THRESHOLD=0.35

# Frame budget for hackathon hardware (infer on 1 of N+1 decoded frames).
FRAME_SKIP=0
INFERENCE_INTERVAL_S=0.0

# ANPR / OCR. rapidocr = offline PP-OCR (default); easyocr = needs network.
OCR_ENGINE=auto
ANPR_CONF_THRESHOLD=0.30
ANPR_LOW_CONFIDENCE=0.55

# Reconnect backoff 2 -> 4 -> 8 -> 16 -> 30 (s).
RECONNECT_MIN=2
RECONNECT_MAX=30

# Evidence + dead-letter output (gitignored runtime dirs).
EVIDENCE_DIR=./cv-engine/var/evidence
DEDUP_WINDOW=45

# How many cameras a single run may open (start at 1!).
MAX_CAMERAS=1
