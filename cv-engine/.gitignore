# model weights & dev artifacts — never commit
*.pt
*.onnx
*.engine
models_dev/
# generated evidence artifacts only — "evidence/" itself is a SOURCE package
evidence_out/
__pycache__/
*.pyc

# local demo feed videos (large binaries — place manually, see scripts/run_feed_demo.py)
feeds/

# training artefacts (frames, labels, runs) — keep the scripts
training/datasets/
training/runs/
training/reports/frames/
training/reports/*.json
training/reports/FOOTAGE_DECODED.md

# Runtime evidence crops (served by the backend at /api/evidence/...).
# Keep the source package (evidence/*.py) tracked, ignore generated output.
evidence/*/
evidence/dead_letter_events.jsonl
