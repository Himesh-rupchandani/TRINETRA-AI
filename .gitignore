.venv/
__pycache__/
*.pyc

# Workspace snapshot archives (stale code copies — never commit)
workspace-*.zip

# Uploaded zips replaced by real source folders
trinetra_detection.zip

# --- Local configuration & secrets (NEVER commit) ---------------------------
# Real credentials live only in these untracked files; the committed
# *.env.example templates carry empty values and documentation.
.env
.env.*
!.env.example
!**/.env.example

# detection_backend: runtime outputs & heavy weights (license-plate weight excepted)
detection_backend/results/
detection_backend/evidence_frames/
detection_backend/footages_and_videos/
detection_backend/jobs/
detection_backend/models/*.pt
!detection_backend/models/license-plate-finetune-v1n.pt
