{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build --prefix trinetra-ai",
  "outputDirectory": "trinetra-ai/dist",
  "installCommand": "npm install --prefix trinetra-ai",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
