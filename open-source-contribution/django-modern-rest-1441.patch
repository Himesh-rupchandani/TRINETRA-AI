+    def _with_converter_schemas(
+        self,
+        params_list: list[Parameter | Reference],
+        converters: Mapping[str, Any],
+    ) -> list[Parameter | Reference]:
+        """Add extra schema fields for the known Django converters."""
+        return [
+            self._with_converter_schema(
+                path_param,
+                converters.get(path_param.name)
+                if isinstance(path_param, Parameter)
+                else None,
+            )
+            for path_param in params_list
+        ]
+
+    def _with_converter_schema(
+        self,
+        path_param: Parameter | Reference,
+        converter: Any,
+    ) -> Parameter | Reference:
+        """Merge the converter schema fields with the generated ones."""
+        converter_schema = self._converter_schemas.get(
+            type(converter),  # pyright: ignore[reportUnknownArgumentType]
+        )
+        if (
+            converter_schema is None
+            or not isinstance(path_param, Parameter)
+            or not isinstance(path_param.schema, Schema)
+        ):
+            return path_param
+        return dataclasses.replace(
+            path_param,
+            schema=dataclasses.replace(
+                path_param.schema,
+                **{
+                    field.name: getattr(converter_schema, field.name)
+                    for field in dataclasses.fields(converter_schema)
+                    if getattr(converter_schema, field.name) is not None
+                },
+            ),
+        )
