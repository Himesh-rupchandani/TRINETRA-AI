diff --git a/docs/pages/components/path.rst b/docs/pages/components/path.rst
index 4685901..c79ed00 100644
--- a/docs/pages/components/path.rst
+++ b/docs/pages/components/path.rst
@@ -34,6 +34,11 @@ What happens here?
 Django supports multiple pre-defined path converter types:
 ``int``, ``uuid``, ``str``, ``slug``, ``path``.
 
+We document all of them in the OpenAPI schema:
+``int`` and ``uuid`` are mapped to the matching schema types,
+``slug`` also gets its ``[-a-zA-Z0-9_]+`` pattern,
+and ``path`` is documented as a ``str`` that can contain slashes.
+
 .. seealso::
 
   - https://docs.djangoproject.com/en/stable/topics/http/urls/
diff --git a/tests/test_unit/test_openapi/test_path_converters.py b/tests/test_unit/test_openapi/test_path_converters.py
new file mode 100644
index 0000000..4b5ee1a
--- /dev/null
+++ b/tests/test_unit/test_openapi/test_path_converters.py
@@ -0,0 +1,55 @@
+from typing import Any
+
+from django.urls import converters, path
+
+from dmr import Controller
+from dmr.openapi import build_schema
+from dmr.plugins.pydantic import PydanticSerializer
+from dmr.routing import Router
+
+
+class _ArticleController(Controller[PydanticSerializer]):
+    def get(self) -> str:
+        raise NotImplementedError
+
+
+def _get_path_parameters(schema: Any, url_path: str) -> dict[str, Any]:
+    operation_parameters = schema['paths'][url_path]['get']['parameters']
+    return {parameter['name']: parameter for parameter in operation_parameters}
+
+
+def _assert_path_parameters(path_parameters: dict[str, Any]) -> None:
+    for parameter in path_parameters.values():
+        assert parameter['in'] == 'path'
+        assert parameter['required'] is True
+
+
+def test_builtin_path_converters() -> None:
+    """Ensure that built-in Django converters are reflected in the schema."""
+    schema = build_schema(
+        Router(
+            'api/',
+            [
+                path(
+                    'articles/<int:article_id>/<slug:slug>/<path:tail>/',
+                    _ArticleController.as_view(),
+                ),
+            ],
+        ),
+    ).convert()
+
+    path_parameters = _get_path_parameters(
+        schema,
+        '/api/articles/{article_id}/{slug}/{tail}/',
+    )
+    assert path_parameters['article_id']['schema']['type'] == 'integer'
+
+    slug_schema = path_parameters['slug']['schema']
+    assert slug_schema['pattern'] == converters.SlugConverter.regex
+    assert slug_schema['type'] == 'string'
+
+    tail_schema = path_parameters['tail']['schema']
+    assert tail_schema['description'] == 'Can contain slashes'
+    assert tail_schema['type'] == 'string'
+
+    _assert_path_parameters(path_parameters)
