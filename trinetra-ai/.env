# TRINETRA AI — frontend configuration (BACKEND + FRONTEND ONLY MODE)
# This file is committed and enables LIVE mode against local backend.
# Secrets go in .env.local (gitignored) — never commit passwords.

# Mock mode: false = use real backend at /api (proxied to localhost:8000)
VITE_USE_MOCKS=false

# Backend base URL. /api uses Vite proxy -> BACKEND_ORIGIN
VITE_API_BASE_URL=/api

# Dev-only: where Vite proxies /api to (server-side, no VITE_ prefix)
BACKEND_ORIGIN=http://localhost:8000

# Realtime channel used when mocks are disabled: sse | ws | off
VITE_REALTIME_TRANSPORT=sse

# Map defaults — statewide Gujarat view
VITE_MAP_CENTER_LAT=22.3000
VITE_MAP_CENTER_LNG=71.6000
VITE_MAP_DEFAULT_ZOOM=7

# --- Sentinel media gateway (server-side only) ------------------------------
SENTINEL_WHEP_ORIGIN=http://103.250.160.189:8889

# Server-side WHEP credentials — leave empty in committed file.
# Put real values in trinetra-ai/.env.local (gitignored):
#   SENTINEL_EMAIL=your_email
#   SENTINEL_PASSWORD=your_password
SENTINEL_EMAIL=
SENTINEL_PASSWORD=

# Browser-visible stream path (same-origin)
VITE_STREAM_BASE_PATH=/sentinel/stream
VITE_LIVE_STREAMS=true

# --- Mapbox basemap (optional) ------------------------------------------------
# Public Mapbox token (starts with pk.) enables Mapbox Streets/Hybrid/Satellite
# tiles in the map toggle and makes Mapbox the default basemap.
# Put the real value in .env.local (gitignored) — never commit private tokens.
# Create one at https://account.mapbox.com/access-tokens/ (free tier).
VITE_MAPBOX_TOKEN=
