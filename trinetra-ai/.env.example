# ---------------------------------------------------------------
# TRINETRA AI — frontend configuration
# Copy to .env and adjust. Only NON-SECRET, browser-safe values
# belong here: anything prefixed with VITE_ is compiled into the
# public JS bundle. Never put Sentinel passwords or API keys here.
# ---------------------------------------------------------------

# ---------------- MODE ----------------
# LIVE (default): real backend + real Sentinel streams, no synthetic data.
VITE_USE_MOCKS=false
# DEMO: synthetic data everywhere, no backend needed (npm run dev:demo).
# VITE_USE_MOCKS=true

# Backend base URL. Leave as /api to use a same-origin reverse proxy.
VITE_API_BASE_URL=/api

# Dev-only origin the Vite dev server proxies /api to (not bundled).
VITE_BACKEND_ORIGIN=http://localhost:8000

# Realtime channel used when mocks are disabled: sse | ws | off
VITE_REALTIME_TRANSPORT=sse

# Map defaults (Ahmedabad, Gujarat)
VITE_MAP_CENTER_LAT=23.0225
VITE_MAP_CENTER_LNG=72.5714
VITE_MAP_DEFAULT_ZOOM=13

# --- Sentinel media gateway -------------------------------------------------
# Server-side only (NO VITE_ prefix -> never compiled into the browser bundle).
# The dev server / reverse proxy forwards /sentinel/* here, so the UI stays
# same-origin: no mixed content over HTTPS, no CORS, no credentials in the app.
SENTINEL_WHEP_ORIGIN=http://103.250.160.189:8889

# Browser-visible path the UI posts WHEP offers to (same-origin, no secrets).
VITE_STREAM_BASE_PATH=/sentinel/stream
# Live WebRTC on by default; set false to fall back to poster + metadata only.
VITE_LIVE_STREAMS=true
