# ---------------------------------------------------------------
# TRINETRA AI — frontend configuration
# Only NON-SECRET, browser-safe values belong in this file.
# Never put Sentinel passwords, API keys or tokens here: anything
# prefixed with VITE_ is compiled into the public JS bundle.
# ---------------------------------------------------------------

# Mock mode: run the entire product with synthetic demo data, no backend.
VITE_USE_MOCKS=true

# Backend base URL. Leave as /api to use a same-origin reverse proxy.
VITE_API_BASE_URL=/api

# Realtime channel used when mocks are disabled: sse | ws | off
# Both are served by the backend: /api/stream (SSE) and /api/ws/events (WS).
VITE_REALTIME_TRANSPORT=sse

# Map defaults. The camera grid spans Gujarat (Ahmedabad → Junagadh →
# Rajkot → Navsari → Kutch), so the default view is statewide, not one city.
VITE_MAP_CENTER_LAT=22.3000
VITE_MAP_CENTER_LNG=71.6000
VITE_MAP_DEFAULT_ZOOM=7

# Dev-only: origin the Vite dev server proxies /api to.
# Deliberately NOT VITE_-prefixed, so it is never compiled into the bundle.
# For backend+frontend only mode, keep this as http://localhost:8000
BACKEND_ORIGIN=http://localhost:8000

# To run WITHOUT backend (pure mock mode), set:
# VITE_USE_MOCKS=true and you can leave BACKEND_ORIGIN empty
# For backend+frontend (recommended), use:
# VITE_USE_MOCKS=false + BACKEND_ORIGIN=http://localhost:8000

# --- Sentinel media gateway -------------------------------------------------
# Server-side only (NO VITE_ prefix -> never compiled into the browser bundle).
# The dev server / reverse proxy forwards /sentinel/* here, so the UI stays
# same-origin: no mixed content over HTTPS, no CORS, no credentials in the app.
SENTINEL_WHEP_ORIGIN=http://103.250.160.189:8889

# Server-side WHEP credentials (same email + access password as the Sentinel
# portal / TRINETRAAI/backend/.env). The dev proxy injects them as HTTP Basic
# auth on every /sentinel request — the integrator guide requires WebRTC to
# authenticate each connection. Leave empty only if the gateway is open.
# The '@' in the email may be written plainly here (the proxy base64-encodes).
SENTINEL_EMAIL=
SENTINEL_PASSWORD=

# Browser-visible path the UI posts WHEP offers to (same-origin, no secrets).
VITE_STREAM_BASE_PATH=/sentinel/stream
# Live WebRTC on by default; set false to fall back to synthetic demo frames.
VITE_LIVE_STREAMS=true
