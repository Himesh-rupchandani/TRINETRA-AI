# -----------------------------------------------------------------
# TRINETRA AI — local official-camera configuration (Windows/dev)
# -----------------------------------------------------------------
# This file is a template. Copy it to .env.local or run:
#   powershell -NoProfile -ExecutionPolicy Bypass -File .\scripts\configure-official-camera.ps1
#
# .env.local is ignored by Git and is read only by the local Vite server.
# Enter the real values only on your own approved machine. Never commit, paste,
# log, screenshot, or send these values in chat.

# Switch the dashboard from synthetic demo data to the local backend.
VITE_USE_MOCKS=false
VITE_API_BASE_URL=/api
VITE_REALTIME_TRANSPORT=sse
# This has NO VITE_ prefix because it is only used by vite.config.ts to proxy
# browser /api requests to the local backend.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Official WHEP gateway. Keep this server-side; it is never put in browser JS.
SENTINEL_WHEP_ORIGIN=http://103.250.160.189:8889

# >>> Enter the approved official camera account locally, after the equals sign.
# Do NOT add a VITE_ prefix. The Vite reverse proxy injects Basic auth while
# the browser sees only the same-origin /sentinel path.
SENTINEL_EMAIL=
SENTINEL_PASSWORD=

# If a value contains spaces or #, wrap the full value in double quotes.
# Leave @ unescaped in the email; the backend encodes it when it builds RTSP.

# Browser-safe settings. These are intentionally public and may use VITE_.
VITE_STREAM_BASE_PATH=/sentinel/stream
VITE_LIVE_STREAMS=true
